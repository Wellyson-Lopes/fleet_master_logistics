<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title"><%= @client.name %></div>
    <div class="sys-dash-subtitle">Documento: <%= @client.formatted_document %></div>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "← Voltar", clients_path, class: "sys-btn sys-btn-ghost sys-btn-sm" %>
    <%= link_to "Editar Cliente", edit_client_path(@client), class: "sys-btn sys-btn-primary sys-btn-sm" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <div class="md:col-span-2 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-lg font-bold text-gray-900 border-b pb-4 mb-4">Dados Cadastrais</h3>

    <dl class="grid grid-cols-2 gap-x-4 gap-y-4 text-sm">
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Razão Social / Nome</dt>
        <dd class="text-base font-bold text-gray-900"><%= @client.name %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Documento</dt>
        <dd class="text-gray-800 font-mono"><%= @client.formatted_document %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">E-mail</dt>
        <dd class="text-gray-800"><%= @client.email.presence || '-' %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Telefone</dt>
        <dd class="text-gray-800"><%= @client.phone.presence || '-' %></dd>
      </div>
      <div class="col-span-2">
        <dt class="text-xs font-bold text-gray-400 uppercase">Endereço</dt>
        <dd class="text-gray-800"><%= [@client.address, @client.city, @client.state, @client.zip_code].compact_blank.join(', ').presence || '-' %></dd>
      </div>
      <% if @client.notes.present? %>
        <div class="col-span-2">
          <dt class="text-xs font-bold text-gray-400 uppercase">Observações</dt>
          <dd class="text-gray-700 bg-gray-50 p-3 rounded-xl mt-1 text-xs"><%= simple_format(@client.notes) %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-lg font-bold text-gray-900 border-b pb-4 mb-4">Locações de Máquinas</h3>
    <% rentals = @client.machinery_rentals.order(created_at: :desc) %>
    <% if rentals.any? %>
      <div class="space-y-3">
        <% rentals.each do |r| %>
          <div class="p-3 bg-gray-50 border border-gray-100 rounded-xl text-xs">
            <div class="flex justify-between font-bold text-gray-800">
              <span><%= r.machinery.name %></span>
              <span class="<%= r.status_badge_class %> px-2 py-0.5 rounded-full"><%= r.status_human %></span>
            </div>
            <div class="text-gray-500 mt-1"><%= r.code %> · <%= number_to_currency(r.total_amount, unit: 'R$ ') %></div>
            <%= link_to "Ver Locação →", machinery_rental_path(r), class: "inline-block mt-2 font-bold text-blue-600 hover:underline" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-500">Nenhum contrato de aluguel vinculado a este cliente ainda.</p>
      <%= link_to "+ Novo Aluguel", new_machinery_rental_path, class: "mt-3 inline-block text-xs font-bold text-blue-600 hover:underline" %>
    <% end %>
  </div>
</div>
