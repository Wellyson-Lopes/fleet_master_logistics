<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title">Gestão da Frota</div>
    <div class="sys-dash-subtitle">Listagem de veículos e caminhões da empresa</div>
  </div>
  <div>
    <%= link_to new_vehicle_path, class: "sys-btn sys-btn-primary sys-btn-sm" do %>
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sys-w-13 sys-h-13"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo Veículo
    <% end %>
  </div>
</div>

<div class="sys-card sys-p-20 bg-white border border-gray-200 rounded-2xl shadow-sm mb-6">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-2">
      <span class="text-sm font-semibold text-gray-700">Total: <%= @vehicles.count %> veículos</span>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider bg-gray-50">
          <th class="py-3 px-4">Placa / Veículo</th>
          <th class="py-3 px-4">Tipo</th>
          <th class="py-3 px-4">Ano / Modelo</th>
          <th class="py-3 px-4">Capacidade (kg)</th>
          <th class="py-3 px-4">Quilometragem</th>
          <th class="py-3 px-4">Motorista Atual</th>
          <th class="py-3 px-4">Status</th>
          <th class="py-3 px-4 text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 text-sm">
        <% if @vehicles.empty? %>
          <tr>
            <td colspan="8" class="text-center py-8 text-gray-400">
              Nenhum veículo cadastrado na frota. Clique em "Novo Veículo" para começar.
            </td>
          </tr>
        <% else %>
          <% @vehicles.each do |v| %>
            <tr class="hover:bg-gray-50 transition">
              <td class="py-3.5 px-4 font-bold text-gray-900">
                <%= link_to v.plate, vehicle_path(v), class: "text-blue-600 hover:underline font-mono" %>
                <% if v.brand.present? || v.model.present? %>
                  <span class="block text-xs font-normal text-gray-500"><%= "#{v.brand} #{v.model}".strip %></span>
                <% end %>
              </td>
              <td class="py-3.5 px-4 text-gray-700 font-medium"><%= v.type %></td>
              <td class="py-3.5 px-4 text-gray-600"><%= v.year || '-' %></td>
              <td class="py-3.5 px-4 text-gray-600"><%= v.load_capacity_kg ? number_with_delimiter(v.load_capacity_kg) : '-' %> kg</td>
              <td class="py-3.5 px-4 text-gray-600"><%= v.current_mileage_km ? "#{number_with_delimiter(v.current_mileage_km)} km" : '-' %></td>
              <td class="py-3.5 px-4">
                <% if driver = v.current_driver %>
                  <span class="text-xs font-semibold px-2 py-1 bg-teal-50 text-teal-700 rounded-md">
                    👤 <%= driver.name %>
                  </span>
                <% else %>
                  <span class="text-xs text-gray-400">Disponível</span>
                <% end %>
              </td>
              <td class="py-3.5 px-4">
                <% case v.status %>
                <% when 'active' %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Ativo</span>
                <% when 'maintenance' %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Manutenção</span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Inativo</span>
                <% end %>
              </td>
              <td class="py-3.5 px-4 text-right space-x-2">
                <%= link_to "Detalhes", vehicle_path(v), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
                <%= link_to "Editar", edit_vehicle_path(v), class: "text-xs font-semibold text-gray-600 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
