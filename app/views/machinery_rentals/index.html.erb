<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title">Locação de Máquinas & Equipamentos</div>
    <div class="sys-dash-subtitle">Gerencie contratos de aluguel por hora ou diária com valores, clientes e status</div>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to machinery_rentals_path(format: :csv, status: params[:status]), data: { turbo: false }, class: "sys-btn sys-btn-ghost sys-btn-sm" do %>
      📊 Exportar Excel (.csv)
    <% end %>
    <%= link_to machineries_path, class: "sys-btn sys-btn-ghost sys-btn-sm" do %>
      Catálogo de Máquinas
    <% end %>
    <%= link_to new_machinery_rental_path, class: "sys-btn sys-btn-primary sys-btn-sm" do %>
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sys-w-13 sys-h-13"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo Aluguel
    <% end %>
  </div>
</div>

<!-- KPIs do Aluguel -->
<div class="sys-kpis-row sys-mb-6">
  <div class="sys-kpi-card blue">
    <div class="sys-kpi-icon blue">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="sys-kpi-value"><%= number_to_currency(@total_revenue, unit: "R$ ", separator: ",", delimiter: ".") %></div>
    <div class="sys-kpi-label">Faturamento Total em Locações</div>
    <div class="sys-kpi-delta up">Receita acumulada</div>
  </div>

  <div class="sys-kpi-card amber">
    <div class="sys-kpi-icon amber">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="sys-kpi-value"><%= @active_rentals_count %></div>
    <div class="sys-kpi-label">Locações Ativas Agora</div>
    <div class="sys-kpi-delta <%= @active_rentals_count > 0 ? 'up' : 'down' %>"><%= @active_rentals_count > 0 ? 'Equipamentos em operação' : 'Sem máquinas alugadas' %></div>
  </div>

  <div class="sys-kpi-card green">
    <div class="sys-kpi-icon green">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="sys-kpi-value"><%= @total_rentals %></div>
    <div class="sys-kpi-label">Total de Contratos</div>
    <div class="sys-kpi-delta up"><%= @rentals.where(status: 'completed').count %> finalizados</div>
  </div>
</div>

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
  <% if @rentals.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-600 uppercase">
            <th class="py-3 px-4">Código / Contrato</th>
            <th class="py-3 px-4">Máquina / Equipamento</th>
            <th class="py-3 px-4">Cliente Contratante</th>
            <th class="py-3 px-4">Modalidade / Tempo</th>
            <th class="py-3 px-4">Taxa Aplicada</th>
            <th class="py-3 px-4">Valor Total</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @rentals.each do |r| %>
            <tr class="hover:bg-gray-50/80 transition">
              <td class="py-3.5 px-4 font-mono font-bold text-blue-600 text-xs">
                <%= link_to r.code, machinery_rental_path(r), class: "hover:underline" %>
                <div class="text-gray-400 font-sans font-normal text-xs"><%= I18n.l(r.start_date.to_date, format: :short) %></div>
              </td>
              <td class="py-3.5 px-4 font-bold text-gray-900">
                <%= link_to r.machinery.name, machinery_path(r.machinery), class: "hover:underline" %>
                <div class="text-xs text-gray-500 font-normal"><%= r.machinery.category %></div>
              </td>
              <td class="py-3.5 px-4 font-medium text-gray-700">
                <%= link_to r.client.name, client_path(r.client), class: "hover:underline" %>
              </td>
              <td class="py-3.5 px-4 text-gray-700">
                <span class="font-semibold"><%= r.rental_type_human %></span>: <%= r.duration.to_i %> <%= r.rental_type == 'hourly' ? 'horas' : 'dias' %>
              </td>
              <td class="py-3.5 px-4 font-medium text-gray-600">
                <%= number_to_currency(r.rate_applied, unit: 'R$ ') %>
              </td>
              <td class="py-3.5 px-4 font-extrabold text-gray-900">
                <%= number_to_currency(r.total_amount, unit: 'R$ ') %>
              </td>
              <td class="py-3.5 px-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= r.status_badge_class %>">
                  <%= r.status_human %>
                </span>
              </td>
              <td class="py-3.5 px-4 text-right space-x-2">
                <%= link_to "Detalhes", machinery_rental_path(r), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
                <%= link_to "Editar", edit_machinery_rental_path(r), class: "text-xs font-semibold text-gray-600 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-8 text-center bg-gray-50 rounded-xl">
      <p class="text-sm font-semibold text-gray-700">Nenhum contrato de aluguel registrado.</p>
      <%= link_to "Iniciar Primeiro Aluguel", new_machinery_rental_path, class: "mt-3 inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-xl transition" %>
    </div>
  <% end %>
</div>
