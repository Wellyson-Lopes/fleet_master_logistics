<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title">Perfil do Motorista</div>
    <div class="sys-dash-subtitle"><%= @driver.name.presence || @driver.email %></div>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "← Voltar para Motoristas", drivers_path, class: "sys-btn sys-btn-ghost sys-btn-sm" %>
    <%= link_to "Editar Dados", edit_driver_path(@driver), class: "sys-btn sys-btn-primary sys-btn-sm" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <div class="md:col-span-2 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-lg font-bold text-gray-900 border-b pb-4 mb-4">Informações Pessoais e CNH</h3>

    <dl class="grid grid-cols-2 gap-x-4 gap-y-4 text-sm">
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Nome Completo</dt>
        <dd class="text-base font-bold text-gray-900"><%= @driver.name.presence || '-' %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">E-mail</dt>
        <dd class="text-gray-800"><%= @driver.email %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Telefone</dt>
        <dd class="text-gray-800"><%= @driver.phone.presence || '-' %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">CPF</dt>
        <dd class="text-gray-800 font-mono"><%= @driver.cpf.presence || '-' %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">CNH</dt>
        <dd class="text-gray-800 font-mono"><%= @driver.cnh.presence || '-' %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Validade da CNH</dt>
        <dd class="text-gray-800">
          <% if @driver.cnh_expiration.present? %>
            <%= I18n.l(@driver.cnh_expiration, format: :long) %>
            <% if @driver.cnh_expired? %>
              <span class="ml-2 text-xs font-bold text-red-600">(VENCIDA)</span>
            <% end %>
          <% else %>
            -
          <% end %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-lg font-bold text-gray-900 border-b pb-4 mb-4">Veículo Alocado</h3>
    
    <% if v = @driver.current_vehicle %>
      <div class="p-4 bg-blue-50 border border-blue-100 rounded-xl">
        <div class="text-xs text-blue-600 font-bold uppercase mb-1">Caminhão Atual</div>
        <div class="text-xl font-extrabold text-blue-900 font-mono"><%= v.plate %></div>
        <div class="text-sm text-blue-700 mt-1"><%= "#{v.brand} #{v.model}".strip.presence || v.type %></div>
        <%= link_to "Ver Veículo →", vehicle_path(v), class: "inline-block mt-3 text-xs font-bold text-blue-600 hover:underline" %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">Nenhum veículo alocado para este motorista no momento.</p>
    <% end %>
  </div>
</div>
