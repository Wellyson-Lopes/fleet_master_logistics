<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title">Gestão de Motoristas</div>
    <div class="sys-dash-subtitle">Lista de motoristas cadastrados e convidados</div>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to new_driver_path, class: "sys-btn sys-btn-primary sys-btn-sm" do %>
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sys-w-13 sys-h-13"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Convidar Motorista
    <% end %>
  </div>
</div>

<div class="sys-card sys-p-20 bg-white border border-gray-200 rounded-2xl shadow-sm">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider bg-gray-50">
          <th class="py-3 px-4">Motorista</th>
          <th class="py-3 px-4">E-mail / Telefone</th>
          <th class="py-3 px-4">CPF / CNH</th>
          <th class="py-3 px-4">Status CNH</th>
          <th class="py-3 px-4">Veículo Alocado</th>
          <th class="py-3 px-4">Status Convite</th>
          <th class="py-3 px-4 text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 text-sm">
        <% if @drivers.empty? %>
          <tr>
            <td colspan="7" class="text-center py-8 text-gray-400">
              Nenhum motorista cadastrado na empresa. Clique em "Convidar Motorista" para enviar um convite.
            </td>
          </tr>
        <% else %>
          <% @drivers.each do |d| %>
            <tr class="hover:bg-gray-50 transition">
              <td class="py-3.5 px-4 font-bold text-gray-900">
                <%= link_to d.name.presence || d.email, driver_path(d), class: "text-blue-600 hover:underline" %>
              </td>
              <td class="py-3.5 px-4 text-gray-600">
                <div><%= d.email %></div>
                <div class="text-xs text-gray-400"><%= d.phone.presence || '-' %></div>
              </td>
              <td class="py-3.5 px-4 text-gray-600 font-mono text-xs">
                <div>CPF: <%= d.cpf.presence || '-' %></div>
                <div>CNH: <%= d.cnh.presence || '-' %></div>
              </td>
              <td class="py-3.5 px-4">
                <% if d.cnh_expiration.present? %>
                  <% if d.cnh_expired? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800">
                      🚨 Vencida (<%= I18n.l(d.cnh_expiration, format: :short) %>)
                    </span>
                  <% elsif d.cnh_expiring_soon? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800">
                      ⚠️ Vence em <%= I18n.l(d.cnh_expiration, format: :short) %>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                      Val. <%= I18n.l(d.cnh_expiration, format: :short) %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-xs text-gray-400">-</span>
                <% end %>
              </td>
              <td class="py-3.5 px-4">
                <% if v = d.current_vehicle %>
                  <span class="text-xs font-bold font-mono px-2 py-1 bg-blue-50 text-blue-700 rounded-md">
                    🚛 <%= v.plate %>
                  </span>
                <% else %>
                  <span class="text-xs text-gray-400">Nenhum</span>
                <% end %>
              </td>
              <td class="py-3.5 px-4">
                <% if d.invitation_accepted_at.present? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Ativo</span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Convite Pendente</span>
                <% end %>
              </td>
              <td class="py-3.5 px-4 text-right space-x-2">
                <%= link_to "Perfil", driver_path(d), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
                <%= link_to "Editar", edit_driver_path(d), class: "text-xs font-semibold text-gray-600 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
