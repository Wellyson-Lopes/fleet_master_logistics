<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title">Dashboard Operacional</div>
    <div class="sys-dash-subtitle"><%= I18n.l(Date.current, format: :long) %> · Olá, <%= current_user.name.split.first %></div>
  </div>
  <div class="sys-flex sys-gap-2">
    <%= link_to new_vehicle_path, class: "sys-btn sys-btn-primary sys-btn-sm" do %>
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sys-w-13 sys-h-13"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo Veículo
    <% end %>
  </div>
</div>

<!-- Sessão Ativa Info -->
<div class="sys-mb-6 sys-flex sys-flex-wrap sys-gap-2 sys-items-center">
  <div class="sys-badge sys-badge-green">
    <span class="sys-dot sys-bg-green-500 sys-animate-pulse"></span>
    <%= @company.name %> · <%= current_user.owner? ? "Administrador" : "Colaborador" %>
  </div>
  <div class="sys-badge sys-badge-blue">
    CNPJ: <%= @company.cnpj %>
  </div>
  <div class="sys-badge sys-badge-gray">
    Plano: <%= @company.plan_name_human %> (<%= @company.billing_cycle == 'annual' ? 'Anual' : 'Mensal' %>)
  </div>
</div>

<!-- KPIs Reais da Empresa -->
<div class="sys-kpis-row">
  <div class="sys-kpi-card blue">
    <div class="sys-kpi-icon blue">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 4v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
    </div>
    <div class="sys-kpi-value"><%= @total_vehicles %></div>
    <div class="sys-kpi-label">Veículos na Frota</div>
    <div class="sys-kpi-delta <%= @total_vehicles > 0 ? 'up' : 'down' %>">
      <%= @available_vehicles %> disponíveis
    </div>
  </div>

  <div class="sys-kpi-card teal">
    <div class="sys-kpi-icon teal">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    </div>
    <div class="sys-kpi-value"><%= @total_drivers %></div>
    <div class="sys-kpi-label">Motoristas Cadastrados</div>
    <div class="sys-kpi-delta up"><%= @active_drivers %> ativos</div>
  </div>

  <div class="sys-kpi-card green">
    <div class="sys-kpi-icon green">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="sys-kpi-value"><%= @active_assignments.count %></div>
    <div class="sys-kpi-label">Alocações em Operação</div>
    <div class="sys-kpi-delta up">Em rota / ativos</div>
  </div>

  <div class="sys-kpi-card amber">
    <div class="sys-kpi-icon amber">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
    </div>
    <div class="sys-kpi-value"><%= @maintenance_vehicles %></div>
    <div class="sys-kpi-label">Em Manutenção</div>
    <div class="sys-kpi-delta <%= @maintenance_vehicles > 0 ? 'down' : 'up' %>">
      <%= @maintenance_vehicles > 0 ? 'Atenção necessária' : 'Frota operacional' %>
    </div>
  </div>
</div>

<div class="sys-dash-content-grid">
  <!-- Alocações e Operações Ativas -->
  <div class="sys-card sys-p-16">
    <div class="sys-card-header sys-mb-12">
      <div class="sys-card-title">Operações e Alocações Ativas</div>
      <%= link_to "Ver Frota", vehicles_path, class: "sys-btn sys-btn-ghost sys-btn-sm" %>
    </div>
    <div class="sys-flex sys-flex-col sys-gap-2">
      <% if @active_assignments.any? %>
        <% @active_assignments.each do |assignment| %>
          <div class="sys-item-row">
            <div class="sys-item-icon-box sys-bg-blue-light-10">
              <svg fill="none" viewBox="0 0 24 24" stroke="#2563EB" stroke-width="2" class="sys-w-16 sys-h-16"><rect x="1" y="3" width="15" height="13"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div class="sys-item-info">
              <div class="sys-item-title"><%= assignment.driver.name %> · <span class="font-mono"><%= assignment.vehicle.plate %></span></div>
              <div class="sys-item-subtitle"><%= "#{assignment.vehicle.brand} #{assignment.vehicle.model}".strip.presence || assignment.vehicle.type %> · Desde <%= I18n.l(assignment.assigned_at, format: :short) %></div>
            </div>
            <span class="sys-badge sys-badge-green">Alocado</span>
          </div>
        <% end %>
      <% else %>
        <div class="p-8 text-center bg-gray-50 rounded-2xl border border-dashed border-gray-200">
          <svg class="w-10 h-10 mx-auto text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="1" y="3" width="15" height="13"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <p class="text-sm font-semibold text-gray-700">Nenhum veículo alocado no momento</p>
          <p class="text-xs text-gray-500 mt-1">Acesse a gestão de veículos para atribuir motoristas aos caminhões.</p>
          <%= link_to "Gerenciar Frota", vehicles_path, class: "mt-4 inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs rounded-xl transition" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Status da Frota e Alertas -->
  <div class="sys-card sys-p-16">
    <div class="sys-card-header sys-mb-12">
      <div class="sys-card-title">Status da Frota & Alertas</div>
    </div>
    <div class="sys-status-list">
      <div>
        <div class="sys-flex sys-justify-between sys-mb-1 sys-text-11">
          <span class="sys-text-gray-600">Disponíveis / Ativos</span>
          <span class="sys-font-bold sys-text-green"><%= @available_vehicles %>/<%= @total_vehicles %></span>
        </div>
        <% pct_disp = @total_vehicles > 0 ? (@available_vehicles.to_f / @total_vehicles * 100).round : 0 %>
        <div class="sys-progress-bar"><div class="sys-progress-fill sys-bg-green" style="width: <%= pct_disp %>%;"></div></div>
      </div>
      <div>
        <div class="sys-flex sys-justify-between sys-mb-1 sys-text-11">
          <span class="sys-text-gray-600">Em Manutenção</span>
          <span class="sys-font-bold sys-text-amber"><%= @maintenance_vehicles %>/<%= @total_vehicles %></span>
        </div>
        <% pct_maint = @total_vehicles > 0 ? (@maintenance_vehicles.to_f / @total_vehicles * 100).round : 0 %>
        <div class="sys-progress-bar"><div class="sys-progress-fill sys-bg-amber" style="width: <%= pct_maint %>%;"></div></div>
      </div>
      <div>
        <div class="sys-flex sys-justify-between sys-mb-1 sys-text-11">
          <span class="sys-text-gray-600">Inativos</span>
          <span class="sys-font-bold sys-text-red"><%= @inactive_vehicles %>/<%= @total_vehicles %></span>
        </div>
        <% pct_inact = @total_vehicles > 0 ? (@inactive_vehicles.to_f / @total_vehicles * 100).round : 0 %>
        <div class="sys-progress-bar"><div class="sys-progress-fill sys-bg-red" style="width: <%= pct_inact %>%;"></div></div>
      </div>
    </div>

    <div class="sys-mt-6 sys-pt-12 sys-border-top">
      <div class="sys-text-11 sys-font-bold sys-text-gray-500 sys-mb-2">Alertas de Vencimento de CNH</div>
      <div class="sys-alert-list">
        <% if @cnh_alerts.any? %>
          <% @cnh_alerts.each do |driver| %>
            <div class="sys-flex sys-justify-between sys-text-11 py-1 border-b border-gray-100 last:border-none">
              <span class="sys-text-gray-700">👤 <%= driver.name %></span>
              <% if driver.cnh_expired? %>
                <span class="sys-text-red sys-font-bold">CNH Vencida</span>
              <% else %>
                <span class="sys-text-amber sys-font-bold"><%= ((driver.cnh_expiration - Date.current).to_i) %> dias</span>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="text-xs text-green-600 flex items-center gap-1.5 py-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Todas as CNHs da empresa em dia
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
