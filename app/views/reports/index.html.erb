<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title">Relatórios & Análise de Fretes</div>
    <div class="sys-dash-subtitle">Consolidado financeiro, tonelagem transportada e eficiência operacional da frota</div>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "Todo o Período", reports_path, class: "sys-btn #{params[:period].blank? ? 'sys-btn-primary' : 'sys-btn-ghost'} sys-btn-sm" %>
    <%= link_to "Últimos 30 dias", reports_path(period: 'last_30_days'), class: "sys-btn #{params[:period] == 'last_30_days' ? 'sys-btn-primary' : 'sys-btn-ghost'} sys-btn-sm" %>
    <%= link_to "Este Mês", reports_path(period: 'this_month'), class: "sys-btn #{params[:period] == 'this_month' ? 'sys-btn-primary' : 'sys-btn-ghost'} sys-btn-sm" %>
  </div>
</div>

<!-- Cards de Indicadores Consolidados -->
<div class="sys-kpis-row sys-mb-6">
  <div class="sys-kpi-card green">
    <div class="sys-kpi-icon green">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="sys-kpi-value"><%= number_to_currency(@total_revenue, unit: "R$ ", separator: ",", delimiter: ".") %></div>
    <div class="sys-kpi-label">Faturamento em Fretes</div>
    <div class="sys-kpi-delta up">Total acumulado</div>
  </div>

  <div class="sys-kpi-card teal">
    <div class="sys-kpi-icon teal">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
    </div>
    <div class="sys-kpi-value"><%= number_with_delimiter(@total_cargo_ton) %> ton</div>
    <div class="sys-kpi-label">Volume Total Transportado</div>
    <div class="sys-kpi-delta up">Carga total</div>
  </div>

  <div class="sys-kpi-card blue">
    <div class="sys-kpi-icon blue">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
    </div>
    <div class="sys-kpi-value"><%= number_to_currency(@avg_ticket, unit: "R$ ", separator: ",", delimiter: ".") %></div>
    <div class="sys-kpi-label">Frete Médio por Viagem</div>
    <div class="sys-kpi-delta up">Ticket médio</div>
  </div>

  <div class="sys-kpi-card amber">
    <div class="sys-kpi-icon amber">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
    </div>
    <div class="sys-kpi-value"><%= @total_trips %></div>
    <div class="sys-kpi-label">Viagens Registradas</div>
    <div class="sys-kpi-delta up"><%= @trips.where(status: 'delivered').count %> concluídas</div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Ranking de Desempenho por Motorista -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-base font-bold text-gray-900 border-b pb-4 mb-4 flex items-center justify-between">
      <span>Ranking de Desempenho por Motorista</span>
      <span class="text-xs font-normal text-gray-500">Ordenado por faturamento</span>
    </h3>

    <% if @driver_stats.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="text-xs font-bold text-gray-500 border-b pb-2 uppercase">
              <th class="pb-2">Motorista</th>
              <th class="pb-2 text-center">Viagens (Entregues)</th>
              <th class="pb-2 text-right">Toneladas</th>
              <th class="pb-2 text-right">Frete Gerado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @driver_stats.each do |stat| %>
              <tr class="hover:bg-gray-50">
                <td class="py-3 font-semibold text-gray-800">
                  <%= stat[:driver].name %>
                </td>
                <td class="py-3 text-center text-gray-600">
                  <%= stat[:trips_count] %> (<%= stat[:delivered_count] %>)
                </td>
                <td class="py-3 text-right text-gray-700">
                  <%= stat[:cargo_ton] %> ton
                </td>
                <td class="py-3 text-right font-bold text-green-700">
                  <%= number_to_currency(stat[:revenue], unit: "R$ ", separator: ",", delimiter: ".") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-xs text-gray-500 py-6 text-center">Nenhum dado registrado para o período selecionado.</p>
    <% end %>
  </div>

  <!-- Desempenho e Eficiência por Caminhão -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-base font-bold text-gray-900 border-b pb-4 mb-4 flex items-center justify-between">
      <span>Eficiência de Capacidade por Caminhão</span>
      <span class="text-xs font-normal text-gray-500">Aproveitamento de carga</span>
    </h3>

    <% if @vehicle_stats.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="text-xs font-bold text-gray-500 border-b pb-2 uppercase">
              <th class="pb-2">Caminhão</th>
              <th class="pb-2 text-center">Viagens</th>
              <th class="pb-2 text-center">Aproveitamento Médio</th>
              <th class="pb-2 text-right">Frete Gerado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @vehicle_stats.each do |stat| %>
              <tr class="hover:bg-gray-50">
                <td class="py-3 font-mono font-bold text-gray-800">
                  <%= stat[:vehicle].plate %>
                  <span class="block font-sans text-xs font-normal text-gray-500"><%= stat[:vehicle].model %></span>
                </td>
                <td class="py-3 text-center text-gray-600">
                  <%= stat[:trips_count] %>
                </td>
                <td class="py-3 text-center">
                  <span class="font-bold <%= stat[:avg_occupancy] > 100 ? 'text-red-600' : 'text-blue-600' %>">
                    <%= stat[:avg_occupancy] %>%
                  </span>
                </td>
                <td class="py-3 text-right font-bold text-green-700">
                  <%= number_to_currency(stat[:revenue], unit: "R$ ", separator: ",", delimiter: ".") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-xs text-gray-500 py-6 text-center">Nenhum dado registrado para o período selecionado.</p>
    <% end %>
  </div>
</div>
