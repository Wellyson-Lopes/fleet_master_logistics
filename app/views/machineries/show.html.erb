<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title"><%= @machinery.name %></div>
    <div class="sys-dash-subtitle"><%= @machinery.category %> · <%= @machinery.status_human %></div>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "← Voltar", machineries_path, class: "sys-btn sys-btn-ghost sys-btn-sm" %>
    <% if @machinery.available? %>
      <%= link_to "+ Alugar Esta Máquina", new_machinery_rental_path(machinery_id: @machinery.id), class: "sys-btn sys-btn-primary sys-btn-sm" %>
    <% end %>
    <%= link_to "Editar", edit_machinery_path(@machinery), class: "sys-btn sys-btn-ghost sys-btn-sm" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <div class="md:col-span-2 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-lg font-bold text-gray-900 border-b pb-4 mb-4">Especificações e Valores</h3>

    <dl class="grid grid-cols-2 gap-x-4 gap-y-4 text-sm">
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Categoria</dt>
        <dd class="text-base font-bold text-gray-900"><%= @machinery.category %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Status Atual</dt>
        <dd class="mt-1">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= @machinery.status_badge_class %>">
            <%= @machinery.status_human %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Marca / Fabricante</dt>
        <dd class="text-gray-800"><%= @machinery.brand.presence || '-' %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Modelo / Ano</dt>
        <dd class="text-gray-800"><%= [@machinery.model, @machinery.year].compact_blank.join(' · ').presence || '-' %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Nº de Série / Chassi</dt>
        <dd class="text-gray-800 font-mono"><%= @machinery.serial_number.presence || '-' %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold text-gray-400 uppercase">Tabela de Preços</dt>
        <dd class="text-sm font-bold text-blue-900">
          <%= number_to_currency(@machinery.hourly_rate, unit: 'R$ ') %>/hora · <%= number_to_currency(@machinery.daily_rate, unit: 'R$ ') %>/dia
        </dd>
      </div>
      <% if @machinery.notes.present? %>
        <div class="col-span-2">
          <dt class="text-xs font-bold text-gray-400 uppercase">Observações Técnicas</dt>
          <dd class="text-gray-700 bg-gray-50 p-3 rounded-xl mt-1 text-xs"><%= simple_format(@machinery.notes) %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-lg font-bold text-gray-900 border-b pb-4 mb-4">Histórico de Locações</h3>
    <% if @active_rentals.any? %>
      <div class="space-y-3">
        <% @active_rentals.each do |r| %>
          <div class="p-3 bg-gray-50 border border-gray-100 rounded-xl text-xs">
            <div class="flex justify-between font-bold text-gray-800">
              <span><%= r.client.name %></span>
              <span class="<%= r.status_badge_class %> px-2 py-0.5 rounded-full"><%= r.status_human %></span>
            </div>
            <div class="text-gray-500 mt-1 font-mono"><%= r.code %> · <%= r.rental_type_human %> (<%= r.duration.to_i %> <%= r.rental_type == 'hourly' ? 'h' : 'dias' %>)</div>
            <div class="text-blue-700 font-extrabold mt-1"><%= number_to_currency(r.total_amount, unit: 'R$ ') %></div>
            <%= link_to "Ver Contrato →", machinery_rental_path(r), class: "inline-block mt-2 font-bold text-blue-600 hover:underline" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-500">Nenhum histórico de aluguel para esta máquina ainda.</p>
    <% end %>
  </div>
</div>
