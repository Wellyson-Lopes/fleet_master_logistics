<div class="sys-dash-topbar">
  <div>
    <div class="sys-dash-title">Cobranças & Faturamento Asaas</div>
    <div class="sys-dash-subtitle">Emita e acompanhe cobranças via PIX, Boleto Bancário e Cartão de Crédito</div>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to new_payment_path, class: "sys-btn sys-btn-primary sys-btn-sm" do %>
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="sys-w-13 sys-h-13"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Nova Cobrança Asaas
    <% end %>
  </div>
</div>

<div class="sys-kpis-row sys-mb-6">
  <div class="sys-kpi-card green">
    <div class="sys-kpi-icon green">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="sys-kpi-value"><%= number_to_currency(@total_received, unit: "R$ ") %></div>
    <div class="sys-kpi-label">Valores Recebidos / Pagos</div>
    <div class="sys-kpi-delta up">Confirmados Asaas</div>
  </div>

  <div class="sys-kpi-card amber">
    <div class="sys-kpi-icon amber">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="sys-kpi-value"><%= number_to_currency(@total_pending, unit: "R$ ") %></div>
    <div class="sys-kpi-label">Cobranças Pendentes</div>
    <div class="sys-kpi-delta down">Aguardando pagamento</div>
  </div>
</div>

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
  <% if @charges.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-600 uppercase">
            <th class="py-3 px-4">ID Asaas</th>
            <th class="py-3 px-4">Cliente / Descrição</th>
            <th class="py-3 px-4">Forma de Pagamento</th>
            <th class="py-3 px-4">Vencimento</th>
            <th class="py-3 px-4">Valor</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @charges.each do |c| %>
            <tr class="hover:bg-gray-50/80 transition">
              <td class="py-3.5 px-4 font-mono font-bold text-blue-600 text-xs">
                <%= link_to c.asaas_id.presence || "CHG-#{c.id[0..6]}", payment_path(c), class: "hover:underline" %>
              </td>
              <td class="py-3.5 px-4">
                <div class="font-bold text-gray-900"><%= c.client&.name.presence || 'Cliente Geral' %></div>
                <div class="text-xs text-gray-500"><%= c.description.presence || '-' %></div>
              </td>
              <td class="py-3.5 px-4">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold font-mono bg-blue-50 text-blue-700">
                  <%= c.billing_type %>
                </span>
              </td>
              <td class="py-3.5 px-4 text-gray-700 text-xs">
                <%= I18n.l(c.due_date, format: :short) %>
              </td>
              <td class="py-3.5 px-4 font-extrabold text-gray-900">
                <%= number_to_currency(c.value, unit: 'R$ ') %>
              </td>
              <td class="py-3.5 px-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= c.status_badge_class %>">
                  <%= c.status_human %>
                </span>
              </td>
              <td class="py-3.5 px-4 text-right">
                <%= link_to "Ver QR Code / Fatura", payment_path(c), class: "text-xs font-bold text-blue-600 hover:text-blue-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-8 text-center bg-gray-50 rounded-xl">
      <p class="text-sm font-semibold text-gray-700">Nenhuma cobrança emitida até o momento.</p>
      <%= link_to "Emitir Primeira Cobrança", new_payment_path, class: "mt-3 inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-xl transition" %>
    </div>
  <% end %>
</div>
